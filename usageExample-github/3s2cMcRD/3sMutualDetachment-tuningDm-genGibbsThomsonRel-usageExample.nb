   RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
    RowBox[{"Block", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"arc", "=", 
         RowBox[{"OptionValue", "[", "\"\<measArclength\>\"", "]"}]}], ",", 
        RowBox[{"ang1", "=", 
         RowBox[{"ang", "/.", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"First", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"xJunc", "/.", 
                   RowBox[{"angles", "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "+", 
                 RowBox[{"dInt", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", 
                    RowBox[{"Sin", "[", "phiLin", "]"}]}], ",", 
                    RowBox[{"Cos", "[", "phiLin", "]"}]}], "}"}]}], "+", 
                 RowBox[{"R", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Cos", "[", "phiCircleB", "]"}], ",", 
                    RowBox[{"Sin", "[", "phiCircleB", "]"}]}], "}"}]}], "-", 
                 RowBox[{"R", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"phiCircleB", "+", "ang"}], "]"}], ",", 
                    RowBox[{"Sin", "[", 
