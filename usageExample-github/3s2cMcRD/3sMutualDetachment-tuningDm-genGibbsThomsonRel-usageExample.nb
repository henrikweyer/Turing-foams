Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"junctionAnglesPred", "=", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"thetaAB0", "=", 
         RowBox[{
          RowBox[{"phiCircleB", "-", 
           RowBox[{"Pi", "/", "2"}]}], "/.", 
          RowBox[{"angleList", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "3"}], "]"}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"thetaAC0", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "phiCircleB"}], "+", 
           RowBox[{"Pi", "/", "2"}], "+", 
           RowBox[{"2", "phiLin"}]}], "/.", 
          RowBox[{"angleList", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "3"}], "]"}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"thetaBC", "=", 
         RowBox[{"phiLin", "/.", 
          RowBox[{"angleList", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "3"}], "]"}], "]"}]}]}]}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"angleList", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "1"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Theta]AC", ",", "thetaBC", ",", "\[Theta]AB"}], "}"}], "/.", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Cos", "[", "thetaBC", "]"}], ",", 
                 RowBox[{"Sin", "[", "thetaBC", "]"}]}], "}"}], 
               RowBox[{"\[Sigma]List", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "2", ",", "2"}], "]"}], "]"}]}], ")"}], 
             "\[IndentingNewLine]", "+", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Cos", "[", "\[Theta]AB", "]"}], ",", 
                 RowBox[{"Sin", "[", "\[Theta]AB", "]"}]}], "}"}], 
               RowBox[{"\[Sigma]List", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "2", ",", "1"}], "]"}], "]"}]}], ")"}], 
             "\[IndentingNewLine]", "+", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Cos", "[", "\[Theta]AC", "]"}], ",", 
                 RowBox[{"Sin", "[", "\[Theta]AC", "]"}]}], "}"}], 
               RowBox[{"\[Sigma]List", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "2", ",", "1"}], "]"}], "]"}]}], ")"}]}], 
            "\[IndentingNewLine]", "==", 
            RowBox[{"coreTurnover", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "2"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Theta]AB", ",", "thetaAB0", ",", "0", ",", 
               RowBox[{"Pi", "+", "thetaBC"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Theta]AC", ",", "thetaAC0", ",", 
               RowBox[{
                RowBox[{"-", "Pi"}], "+", "thetaBC"}], ",", "0"}], "}"}]}], 
            "}"}]}], "]"}]}]}], "\[IndentingNewLine]", "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "@", "angleList"}]}], "}"}]}], "]"}]}]], "Input",
