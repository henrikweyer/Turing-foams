Cell[CellGroupData[{

Cell["Functions for fitting junctions", "Subsection",
 CellChangeTimes->{{3.896333708585084*^9, 
  3.896333745762631*^9}},ExpressionUUID->"124f98cf-f1aa-45db-bac6-\
c8de54f103b2"],

Cell["\<\
The interfaces are determined based on the squared norm of the gradient of \
the total-density fields B (m2+c2) & C (m3+c3).
These gradient fields are evaluated in Comsol and exported on a square grid.
We fit the interfaces by a combination of an arc (for the AB / AC interfaces) \
with constant curvature and a straight line for the BC interface (due to \
symmetry of the chosen parameters).
Fitting is done by determining the minimal distance of each point of the \
square grid to the interface line (arc + straight line; function \
\[OpenCurlyDoubleQuote]pointLoss\[CloseCurlyDoubleQuote] below). The loss \
function is defined as the sum over these distances squared weighted by the \
value of the squared norm of the gradient. The sum is performed for both the \
gradients of field B and C and runs in each case over all points on the grid \
for which the squared norm of the gradient is at least half the maximum value \
(function \[OpenCurlyDoubleQuote]lossCircleLine\[CloseCurlyDoubleQuote]). \
This latter condition excludes weak gradients occuring outside the fitted \
interface regions.
To account for the offset between the maxima of the gradients of field B and \
C in the BC interface, a shift dInt is included in the fitting.
To find the minimum of the loss function the Mathematica function FindMinimum \
is used (function \
\[OpenCurlyDoubleQuote]fitCircleLine\[CloseCurlyDoubleQuote]).\
\>", "Text",
 CellChangeTimes->{{3.894523975067959*^9, 3.894524204781794*^9}, {
  3.894524296360023*^9, 3.894524343309923*^9}, {3.894524379943961*^9, 
  3.894524417855956*^9}, {3.894524466025887*^9, 3.8945245719762588`*^9}, {
  3.894527886777927*^9, 3.894527959556947*^9}, {3.894532319657816*^9, 
  3.894532320906853*^9}, {3.928471502420915*^9, 3.9284715310019836`*^9}, {
  3.928471593523122*^9, 3.928471703106359*^9}, {3.928471779399108*^9, 
  3.928471796745789*^9}, {3.9284718282086987`*^9, 
  3.928471978783051*^9}},ExpressionUUID->"dc640351-27e9-4e52-ba75-\
65f8a731d1be"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "@", "pointLoss"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pointLoss", "[", 
    RowBox[{"pnt_", ",", "x0_", ",", "R_", ",", "phiInt_", ",", "phiLin_"}], 
    "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"xint", "=", 
        RowBox[{"x0", "+", 
         RowBox[{"R", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "phiInt", "]"}], ",", 
            RowBox[{"Sin", "[", "phiInt", "]"}]}], "}"}]}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"eLin", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "phiLin", "]"}], ",", 
          RowBox[{"Sin", "[", "phiLin", "]"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"eLinN", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "phiLin", "]"}]}], ",", 
          RowBox[{"Cos", "[", "phiLin", "]"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ePhi", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sin", "[", "phiInt", "]"}]}], ",", 
           RowBox[{"Cos", "[", "phiInt", "]"}]}], "}"}], "*", 
         RowBox[{"Sign", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "phiLin", "]"}], ",", 
             RowBox[{"Sin", "[", "phiLin", "]"}]}], "}"}], ".", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Sin", "[", "phiInt", "]"}]}], ",", 
             RowBox[{"Cos", "[", "phiInt", "]"}]}], "}"}]}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", "dx", ",", "dxLin", ",", "dxPhi"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dx", "=", 
       RowBox[{
        RowBox[{"pnt", "[", 
         RowBox[{"[", 
          RowBox[{";;", "2"}], "]"}], "]"}], "-", "xint"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dxLin", "=", 
       RowBox[{"dx", ".", "eLin"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dxPhi", "=", 
       RowBox[{"dx", ".", "ePhi"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"pnt", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "*", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"dxPhi", ">=", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"dxLin", ">=", "0"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"dx", ".", "eLinN"}], ")"}], "^", "2"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Norm", "[", "dx", "]"}], "^", "2"}]}], 
          "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"dxLin", ">=", "0"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Min", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"dx", ".", "eLinN"}], ")"}], "^", "2"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"R", "-", 
                 RowBox[{"Norm", "[", 
                  RowBox[{
                   RowBox[{"pnt", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", "2"}], "]"}], "]"}], "-", "x0"}], "]"}]}], 
                ")"}], "^", "2"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"R", "-", 
              RowBox[{"Norm", "[", 
               RowBox[{
                RowBox[{"pnt", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", "2"}], "]"}], "]"}], "-", "x0"}], "]"}]}], 
             ")"}], "^", "2"}]}], "\[IndentingNewLine]", "]"}]}], 
        "\[IndentingNewLine]", "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.892636856368164*^9, 3.892636936337077*^9}, {
  3.892636966473742*^9, 3.8926372348639293`*^9}, {3.8926372804680433`*^9, 
  3.892637332227038*^9}, {3.892637410915115*^9, 3.8926374679121313`*^9}, {
  3.892637662166684*^9, 3.8926376725349207`*^9}, {3.892644314478152*^9, 
  3.89264431986952*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"7fa35fce-f7fc-427b-814d-9deb02ec246f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "@", "lossCircleLine"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lossCircleLine", "[", 
    RowBox[{"dataSelB_", ",", "dataSelC_", ",", 
     RowBox[{"xJunc_", "?", "VectorQ"}], ",", 
     RowBox[{"dInt_", "?", "NumericQ"}], ",", 
     RowBox[{"R_", "?", "NumericQ"}], ",", 
     RowBox[{"phiCircleB_", "?", "NumericQ"}], ",", 
     RowBox[{"phiLin_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "lossB", ",", "\[IndentingNewLine]", "lossC", ",", 
       "\[IndentingNewLine]", "x0", ",", 
       RowBox[{"(*", 
        RowBox[{"circle", " ", "center"}], "*)"}], "\[IndentingNewLine]", 
       "phiInt", ",", 
       RowBox[{"(*", 
        RowBox[{
        "angular", " ", "direction", " ", "from", " ", "circle", " ", 
         "center", " ", "to", " ", "intersection", " ", "point", " ", "of", 
         " ", "circle", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"AB", "/", "AC"}], " ", "interface"}], ")"}], " ", "and", 
         " ", "line", " ", 
         RowBox[{"(", 
          RowBox[{"BC", " ", "interface"}], ")"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"eLinN", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "phiLin", "]"}]}], ",", 
          RowBox[{"Cos", "[", "phiLin", "]"}]}], "}"}]}]}], "}"}], " ", 
     RowBox[{"(*", 
      RowBox[{
      "normal", " ", "vector", " ", "of", " ", "the", " ", "BC", " ", 
       "interface", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "pointing", " ", "in", " ", "the", " ", "direction", " ", "at", " ", 
          "angle", " ", 
          RowBox[{"Pi", "/", "2"}]}], "+", "phiLin"}], ")"}]}], "*)"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x0", "=", 
       RowBox[{"xJunc", "+", 
        RowBox[{"dInt", "*", "eLinN"}], "+", 
        RowBox[{"R", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "phiCircleB", "]"}], ",", 
           RowBox[{"Sin", "[", "phiCircleB", "]"}]}], "}"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"phiInt", "=", 
       RowBox[{"phiCircleB", "-", "Pi"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"lossB", "=", 
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"pointLoss", "[", 
           RowBox[{"#", ",", "x0", ",", "R", ",", "phiInt", ",", "phiLin"}], 
           "]"}], "&"}], "/@", "dataSelB"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"x0", "=", 
       RowBox[{"xJunc", "+", 
        RowBox[{
         RowBox[{"ReflectionMatrix", "[", "eLinN", "]"}], ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"dInt", "*", "eLinN"}], "+", 
           RowBox[{"R", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Cos", "[", "phiCircleB", "]"}], ",", 
              RowBox[{"Sin", "[", "phiCircleB", "]"}]}], "}"}]}]}], 
          ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"phiInt", "=", 
       RowBox[{
        RowBox[{"-", "phiCircleB"}], "+", 
        RowBox[{"2", "phiLin"}], "+", "Pi"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"lossC", "=", 
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"pointLoss", "[", 
           RowBox[{"#", ",", "x0", ",", "R", ",", "phiInt", ",", "phiLin"}], 
           "]"}], "&"}], "/@", "dataSelC"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lossB", "+", "lossC"}]}]}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"+", "1000"}], 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{"xJunc", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", "1000"}]}], "]"}], "^", 
       "2"}]}], " ", 
     RowBox[{"(*", 
      RowBox[{
      "regularization", " ", "to", " ", "break", " ", "degeneracy", " ", "if",
        " ", "junction", " ", "point", " ", "leaves", " ", "the", " ", 
       "simulation", " ", "domain", " ", "at", " ", "low", " ", "meeting", 
       " ", "angles"}], "*)"}], "*)"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.8926197942919827`*^9, 3.892619908063035*^9}, {
   3.892620042679679*^9, 3.892620359285855*^9}, {3.892621987471264*^9, 
