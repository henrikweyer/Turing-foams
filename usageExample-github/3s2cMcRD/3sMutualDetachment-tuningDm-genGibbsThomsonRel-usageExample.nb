               RowBox[{"measurementPoints", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], 
           ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coreData", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"xyData", ",", 
         RowBox[{
          RowBox[{"triangleTests", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}], "]"}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"angles", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
