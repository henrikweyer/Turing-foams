            RowBox[{
             RowBox[{"Last", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"xJunc", "/.", 
                   RowBox[{"angles", "[", 
