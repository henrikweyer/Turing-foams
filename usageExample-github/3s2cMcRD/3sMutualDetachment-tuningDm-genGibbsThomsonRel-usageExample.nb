      "calculate", " ", "the", " ", "core", " ", "turnover"}], " ", "&"}], 
    " ", "sign", " ", "of", " ", "ang", " ", "to", " ", "the", " ", 
    "geometry", " ", "of", " ", "the", " ", "interfaces"}], 
