           "\[IndentingNewLine]", 
           RowBox[{"Total", "[", 
            RowBox[{"coreData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "4"}], "]"}], "]"}], "]"}]}], "}"}], "*", 
         RowBox[{"dx", "^", "2"}]}]}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
