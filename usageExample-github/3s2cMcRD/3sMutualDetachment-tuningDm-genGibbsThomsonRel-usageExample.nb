Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "@", "measureCT"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "adapt", " ", "signs", " ", "of", " ", "tangent", " ", "vectors", " ", 
    "in", " ", "the", " ", "triangleTests", " ", "to", " ", "the", " ", 
    "geometry", " ", "of", " ", "the", " ", "interfaces"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measureCT", "[", 
    RowBox[{"angles_", ",", 
     RowBox[{"{", 
      RowBox[{"dataCTx_", ",", "dataCTy_"}], "}"}], ",", "gridCT_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "measurementPoints", ",", "\[IndentingNewLine]", "tvecBC", ",", 
       "\[IndentingNewLine]", "tvecAC", ",", "\[IndentingNewLine]", "tvecAB", 
       ",", "\[IndentingNewLine]", "xyData", ",", "\[IndentingNewLine]", 
       "triangleTests", ",", "\[IndentingNewLine]", "coreData", ",", 
       "\[IndentingNewLine]", "dataAC", ",", "\[IndentingNewLine]", "dataAB", 
       ",", "\[IndentingNewLine]", "dataBC", ",", "\[IndentingNewLine]", 
       "\[Sigma]ABAC", ",", "\[IndentingNewLine]", "\[Sigma]BC", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"dx", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"gridCT", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2", ",", "1"}], "]"}], "]"}], "-", 
          RowBox[{"gridCT", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], "]"}]}]}], 
      RowBox[{"(*", 
       RowBox[{",", "\[IndentingNewLine]", 
        RowBox[{"L", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"gridCT", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "All", ",", "1"}], "]"}], "]"}], "]"}]}]}], 
       "*)"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "determine", " ", "geometry", " ", "of", " ", "rectangles", " ", "to", 
       " ", "measure", " ", "\[Sigma]"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"measurementPoints", "=", 
       RowBox[{"evalPointsCT", "[", "angles", 
        RowBox[{"(*", 
         RowBox[{",", "L"}], "*)"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tvecBC", "=", 
       RowBox[{"measurementPoints", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"tvecAC", "=", 
       RowBox[{"measurementPoints", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"tvecAB", "=", 
       RowBox[{"measurementPoints", "[", 
        RowBox[{"[", 
         RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"xyData", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"gridCT", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"gridCT", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], ",", 
             "dataCTx", ",", "dataCTy"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"triangleTests", "=", 
       RowBox[{"Function", "[", 
        RowBox[{"x", ",", 
         RowBox[{"And", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ".", 
                RowBox[{"(", 
                 RowBox[{"x", "-", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "<", "0"}], 
              ")"}], "&"}], "/@", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"tvecBC", ",", 
