Cell[CellGroupData[{
Cell["\<\
Measure meeting angles & test generalized Gibbs\[Dash]Thomson relation in the \
3-species mutual detachment system\
\>", "Title",
 CellChangeTimes->{{3.894523637124855*^9, 3.894523666609888*^9}, {
  3.903416440102541*^9, 3.903416441297886*^9}, {3.92847678682588*^9, 
  3.928476801952997*^9}},ExpressionUUID->"3f00850e-444b-4160-8745-\
6f0bc9af4827"],

Cell["\<\
Import Comsol simulation of a triple interface junction on a circular domain \
in the 3-species McRD system with mutual detachment.\
\>", "Text",
 CellChangeTimes->{{3.894523676079101*^9, 3.894523748517446*^9}, {
  3.928476818437113*^9, 
  3.9284768283101873`*^9}},ExpressionUUID->"dc1858f3-8fef-4372-b254-\
