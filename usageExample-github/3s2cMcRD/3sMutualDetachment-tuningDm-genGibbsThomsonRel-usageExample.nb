Cell[CellGroupData[{

Cell["Functions for measuring the core turnover", "Subsection",
 CellChangeTimes->{{3.896338340991808*^9, 3.896338350892159*^9}, {
  3.896363544563612*^9, 
  3.896363546789699*^9}},ExpressionUUID->"fa9c30ce-5aa6-422f-a238-\
67e7ec96c0e4"],

Cell["\<\
To calculate the core turnover, one first calculates the triangular area \
around the junction core in which the core turnover is calculated.
To this end, the function evalPointsCT uses the junction positions and \
interface directions fitted above. Assuming the specific layout of the \
interfaces, it calculates the intersection points of the triangle edges with \
the interfaces and the tangent vectors of the interfaces at these points.
The function measureCT calculates the core turnover from the modified core \
turnover by evaluating its integral over the triangular region.

For the test data analyzed here, the branch length used to calculate the core \
turnover is reduced to 1.5.\
\>", "Text",
 CellChangeTimes->{{3.928472249514832*^9, 3.928472363795567*^9}, {
  3.92847258211512*^9, 3.9284726664743*^9}, {3.950355795520987*^9, 
  3.950355837216773*^9}},ExpressionUUID->"0666628d-1bdf-4cee-b948-\
c10bcbd7eb61"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "@", "evalPointsCT"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"evalPointsCT", "[", "angles_", "]"}], ":=", 
   RowBox[{"Quiet", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"xJunc", "/.", 
            RowBox[{"angles", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "+", 
          RowBox[{"1.5", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "phiLin", "]"}], ",", 
             RowBox[{"Sin", "[", "phiLin", "]"}]}], "}"}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "phiLin", "]"}], ",", 
           RowBox[{"Sin", "[", "phiLin", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"xJunc", "/.", 
            RowBox[{"angles", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "+", 
          RowBox[{"dInt", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Sin", "[", "phiLin", "]"}]}], ",", 
             RowBox[{"Cos", "[", "phiLin", "]"}]}], "}"}]}], "+", 
          RowBox[{"R", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "phiCircleB", "]"}], ",", 
             RowBox[{"Sin", "[", "phiCircleB", "]"}]}], "}"}]}], "-", 
          RowBox[{"R", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{"phiCircleB", "+", 
               RowBox[{"1.5", "/", "R"}]}], "]"}], ",", 
             RowBox[{"Sin", "[", 
              RowBox[{"phiCircleB", "+", 
               RowBox[{"1.5", "/", "R"}]}], "]"}]}], "}"}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sin", "[", 
             RowBox[{"phiCircleB", "+", 
              RowBox[{"1.5", "/", "R"}]}], "]"}]}], ",", 
           RowBox[{"Cos", "[", 
            RowBox[{"phiCircleB", "+", 
             RowBox[{"1.5", "/", "R"}]}], "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"xJunc", "/.", 
            RowBox[{"angles", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "-", 
          RowBox[{"dInt", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Sin", "[", "phiLin", "]"}]}], ",", 
             RowBox[{"Cos", "[", "phiLin", "]"}]}], "}"}]}], "+", 
          RowBox[{"R", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{
               RowBox[{"-", "phiCircleB"}], "+", 
               RowBox[{"2", "phiLin"}]}], "]"}], ",", 
             RowBox[{"Sin", "[", 
              RowBox[{
               RowBox[{"-", "phiCircleB"}], "+", 
               RowBox[{"2", "phiLin"}]}], "]"}]}], "}"}]}], "-", 
          RowBox[{"R", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{
               RowBox[{"-", "phiCircleB"}], "+", 
               RowBox[{"2", "phiLin"}], "-", 
               RowBox[{"1.5", "/", "R"}]}], "]"}], ",", 
             RowBox[{"Sin", "[", 
              RowBox[{
