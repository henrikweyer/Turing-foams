 CellLabel->"In[86]:=",ExpressionUUID->"a21ae7a9-e9a7-4af3-ae56-7bfdc6cbec22"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "@", "fitCircleLine"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fitCircleLine", "[", 
    RowBox[{"dataB_", ",", "dataC_", ",", "grid_", ",", "iniCond_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "xyDataB", ",", "\[IndentingNewLine]", "linDataB", ",", 
       "\[IndentingNewLine]", "xyDataC", ",", "\[IndentingNewLine]", 
       "linDataC", ",", "\[IndentingNewLine]", "max", ",", 
       "\[IndentingNewLine]", "dataSelB", ",", "\[IndentingNewLine]", 
       "dataSelC", ",", "\[IndentingNewLine]", "xJunc", ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"coord", ".", " ", "of"}], " ", "junction", " ", "point"}], 
        "*)"}], "\[IndentingNewLine]", "x", ",", 
       RowBox[{"(*", 
        RowBox[{"x", "-", 
         RowBox[{
          RowBox[{"coord", ".", " ", "of"}], " ", "junction"}]}], "*)"}], 
       "\[IndentingNewLine]", "y", ",", 
       RowBox[{"(*", 
        RowBox[{"y", "-", 
         RowBox[{
          RowBox[{"coord", ".", " ", "of"}], " ", "junction"}]}], "*)"}], 
       "\[IndentingNewLine]", "dInt", ",", 
       RowBox[{"(*", 
        RowBox[{
        "normal", " ", "offset", " ", "from", " ", "junction", " ", "point", 
         " ", "of", " ", "BC", " ", "interface", " ", "measured", " ", "by", 
         " ", "B", " ", "or", " ", "C", " ", 
         RowBox[{"grad", "."}]}], " ", "*)"}], "\[IndentingNewLine]", "R", 
       ",", 
       RowBox[{"(*", 
        RowBox[{
        "curvature", " ", "radius", " ", "of", " ", "AB", " ", "and", " ", 
         "AC", " ", "interfaces"}], "*)"}], "\[IndentingNewLine]", 
       "phiCircleB", ",", 
       RowBox[{"(*", 
        RowBox[{
        "angular", " ", "direction", " ", "from", " ", "intersection", " ", 
         "point", " ", "of", " ", "circle", " ", "and", " ", "line", " ", 
         "to", " ", "center", " ", "of", " ", "circle"}], "*)"}], 
       "\[IndentingNewLine]", "phiLin", ",", 
       RowBox[{"(*", 
        RowBox[{"angular", " ", "direction", " ", "of", " ", "line", " ", 
         RowBox[{"(", 
          RowBox[{"BC", " ", "interface"}], ")"}]}], "*)"}], 
       "\[IndentingNewLine]", "fitRes"}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"xyDataB", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"grid", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"grid", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], ",", 
           "dataB"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"xyDataB", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"indx", ",", "indy", ",", 
             RowBox[{"dataB", "[", 
              RowBox[{"[", 
               RowBox[{"indy", ",", "indx"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"indx", ",", 
             RowBox[{"Length", "@", 
              RowBox[{"dataB", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"indy", ",", 
             RowBox[{"Length", "@", "dataB"}]}], "}"}]}], "]"}]}], ";"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"linDataB", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"xyDataB", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"max", "=", 
       RowBox[{"Max", "@", 
        RowBox[{"linDataB", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dataSelB", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"linDataB", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ">", 
           RowBox[{"max", "/", "10"}]}], "&"}]}], "]"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"get", " ", "rid", " ", "of", " ", "near"}], "-", 
         RowBox[{"zero", " ", "values"}]}], ";", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
           "changed", " ", "here", " ", "compared", " ", "to", " ", "the", 
            " ", "case", " ", "of", " ", "mutually"}], "-", 
           RowBox[{
           "suppressed", " ", "attachment", " ", "because", " ", "gradients", 
            " ", "at", " ", "AB"}]}], " ", "&"}], " ", "AC", " ", 
         "interfaces", " ", "become", " ", "weak"}]}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"xyDataC", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"grid", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"grid", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], ",", 
           "dataC"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"xyDataC", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"indx", ",", "indy", ",", 
             RowBox[{"dataC", "[", 
              RowBox[{"[", 
               RowBox[{"indy", ",", "indx"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"indx", ",", 
             RowBox[{"Length", "@", 
              RowBox[{"dataC", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"indy", ",", 
             RowBox[{"Length", "@", "dataC"}]}], "}"}]}], "]"}]}], ";"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"linDataC", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"xyDataC", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
