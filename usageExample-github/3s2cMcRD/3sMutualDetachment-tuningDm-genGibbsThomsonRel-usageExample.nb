Cell[CellGroupData[{

Cell["Determine effective interfacial tensions \[Sigma]AB, \[Sigma]AC, \
\[Sigma]BC", "Section",
 CellChangeTimes->{{3.892783224549287*^9, 3.892783226758006*^9}, {
   3.892796195619817*^9, 3.892796199115478*^9}, {3.894526675159775*^9, 
   3.894526685904497*^9}, 
   3.9284771732595997`*^9},ExpressionUUID->"e891d29c-15c4-4e9f-869c-\
25f9daaec854"],

Cell["\<\
Find points on the interfaces that are distant from the junction to measure \
the effective interfacial tensions.
Around this point, \[Sigma] is determined by integrating the field data\
\[Sigma] over a rectangle crossing the interface. This integral is then \
divided by the width of the rectangle.\
\>", "Text",
 CellChangeTimes->{{3.892797332357519*^9, 3.892797348325391*^9}, {
  3.894526692303344*^9, 3.894526696746167*^9}, {3.894527296574687*^9, 
