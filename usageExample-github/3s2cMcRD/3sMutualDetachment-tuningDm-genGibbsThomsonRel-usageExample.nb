Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"angleList", "=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fit", "=", "0"}], ",", "fitOld", ",", "phiCircleB", ",", 
       "phiLin"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"dataGrad", "[", "\"\<SweepValues\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "i"}], "]"}], "]"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fitOld", "=", "fit"}], ";", "\[IndentingNewLine]", 
        RowBox[{"fit", "=", 
         RowBox[{"fitCircleLine", "[", 
          RowBox[{
           RowBox[{"dataGradB", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"dataGradC", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "grid", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "==", "1"}], ",", "iniCond", ",", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"R", "->", 
                 RowBox[{"Min", "[", 
                  RowBox[{"100", ",", 
                   RowBox[{"(", 
                    RowBox[{"R", "/.", "fitOld"}], ")"}]}], "]"}]}], "}"}], 
               ",", 
               RowBox[{"DeleteCases", "[", 
                RowBox[{"fitOld", ",", 
                 RowBox[{"R", "->", "_"}]}], "]"}]}], "]"}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Show", " ", "fit", " ", "result"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Show", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ListDensityPlot", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"grid", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{";;", ";;", "10"}], ",", 
                    RowBox[{";;", ";;", "10"}], ",", "1"}], "]"}], "]"}], ",", 
                   RowBox[{"grid", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{";;", ";;", "10"}], ",", 
                    RowBox[{";;", ";;", "10"}], ",", "2"}], "]"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{"dataGradB", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Floor", "@", "i"}], ",", 
                    RowBox[{";;", ";;", "10"}], ",", 
                    RowBox[{";;", ";;", "10"}]}], "]"}], "]"}], "+", 
                    RowBox[{"dataGradC", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Floor", "@", "i"}], ",", 
                    RowBox[{";;", ";;", "10"}], ",", 
                    RowBox[{";;", ";;", "10"}]}], "]"}], "]"}]}]}], "}"}], 
                 ",", 
                 RowBox[{"{", 
                  RowBox[{"3", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
               "1"}], "]"}], ",", 
             RowBox[{"PlotRange", "->", "All"}], ",", 
             RowBox[{"InterpolationOrder", "->", "0"}], ",", 
             RowBox[{"AspectRatio", "->", "1"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Graphics", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Black", ",", "\[IndentingNewLine]", 
               RowBox[{"Circle", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"xJunc", "/.", "fit"}], ")"}], "+", 
                   RowBox[{"dInt", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"Sin", "[", "phiLin", "]"}]}], ",", 
                    RowBox[{"Cos", "[", "phiLin", "]"}]}], "}"}]}], "+", 
                   RowBox[{"R", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Cos", "[", "phiCircleB", "]"}], ",", 
                    RowBox[{"Sin", "[", "phiCircleB", "]"}]}], "}"}]}]}], 
                  ")"}], ",", "R", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"phiCircleB", "-", "Pi"}], ",", "Pi"}], "}"}]}], 
                "]"}], ",", "\[IndentingNewLine]", 
               RowBox[{"Darker", "@", "Red"}], ",", "\[IndentingNewLine]", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"xJunc", "/.", "fit"}], ")"}], "+", 
                    RowBox[{"dInt", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"Sin", "[", "phiLin", "]"}]}], ",", 
                    RowBox[{"Cos", "[", "phiLin", "]"}]}], "}"}]}]}], ")"}], 
                  ",", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"xJunc", "/.", "fit"}], ")"}], "+", 
                    RowBox[{"dInt", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"Sin", "[", "phiLin", "]"}]}], ",", 
                    RowBox[{"Cos", "[", "phiLin", "]"}]}], "}"}]}], "+", 
                    RowBox[{"500", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Cos", "[", "phiLin", "]"}], ",", 
                    RowBox[{"Sin", "[", "phiLin", "]"}]}], "}"}]}]}], ")"}]}],
                  "}"}], "]"}], ",", "\[IndentingNewLine]", "Black", ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Circle", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"xJunc", "/.", "fit"}], ")"}], "+", 
                   RowBox[{
                    RowBox[{"ReflectionMatrix", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"Sin", "[", "phiLin", "]"}]}], ",", 
                    RowBox[{"Cos", "[", "phiLin", "]"}]}], "}"}], "]"}], ".", 
                    
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"dInt", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"Sin", "[", "phiLin", "]"}]}], ",", 
                    RowBox[{"Cos", "[", "phiLin", "]"}]}], "}"}]}], "+", 
                    RowBox[{"R", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Cos", "[", "phiCircleB", "]"}], ",", 
                    RowBox[{"Sin", "[", "phiCircleB", "]"}]}], "}"}]}]}], 
                    ")"}]}]}], ")"}], ",", "R", ",", 
                 RowBox[{"{", 
                  RowBox[{"Pi", ",", 
                   RowBox[{
                    RowBox[{"2", "Pi"}], "+", "Pi", "-", "phiCircleB", "+", 
                    RowBox[{"2", "phiLin"}]}]}], "}"}]}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Darker", "@", "Red"}], ",", "\[IndentingNewLine]", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"xJunc", "/.", "fit"}], ")"}], "+", 
                    RowBox[{
                    RowBox[{"ReflectionMatrix", "[", 
                    RowBox[{"{", 
