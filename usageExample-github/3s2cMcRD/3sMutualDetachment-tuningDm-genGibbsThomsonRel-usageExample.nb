  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"evalPointsCTCorr", "[", 
    RowBox[{"angles_", ",", 
     RowBox[{"{", 
      RowBox[{"leftMeasurementEdge_", ",", "upperMeasurementEdge_"}], "}"}], 
     ",", 
