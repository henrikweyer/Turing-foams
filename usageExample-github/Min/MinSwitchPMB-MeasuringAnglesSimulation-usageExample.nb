Cell["Average branch widths", "Subsection",
 CellChangeTimes->{{3.894265724955171*^9, 
  3.894265747904396*^9}},ExpressionUUID->"99938c69-74e4-4de4-a5ab-\
93169f3a3074"],

Cell["\<\
Determine average branch width by binarizing the experimental network image \
(cleanI) at half-maximum intensity, count the white pixels (width*length of \
network) and divide by the white pixels in the network skeleton (length of \
network because everywhere only one pixel wide) \
\>", "Text",
 CellChangeTimes->{{3.8945421044855547`*^9, 
  3.894542205819957*^9}},ExpressionUUID->"aff9dabc-b57d-41f6-bc18-\
13b75377e748"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"width", "=", 
  RowBox[{
   RowBox[{"N", "@", 
    RowBox[{"Total", "@", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ImageData", "[", 
         RowBox[{"Binarize", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Image", "[", "sim", "]"}], "//", "ImageAdjust"}], ",", 
           "0.5"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"sim", ",", "data"}], "}"}]}], "]"}]}]}]}], "/", 
   RowBox[{"(", 
    RowBox[{"Total", "@", 
     RowBox[{"Flatten", "@", 
      RowBox[{"(", 
       RowBox[{"ImageData", "/@", "branchIm"}], ")"}]}]}], ")"}]}]}]], "Input",\

 CellChangeTimes->{{3.894265585761516*^9, 3.894265586894925*^9}, {
  3.894265650380055*^9, 3.894265654658938*^9}, {3.894265732220055*^9, 
