            RowBox[{"[", "2", "]"}], "]"}], "]"}], "&"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"vertMeas", ",", "vertex3MeasurementsRaw"}], "}"}]}], "]"}]}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "indices", " ", "of", " ", "successfully", " ", "fitted", " ", 
    "vertices"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"failedVertices", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
