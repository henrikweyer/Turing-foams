Cell["Analyze domain-size and hole correlation", "Section",
 CellChangeTimes->{{3.8945988146144753`*^9, 
  3.894598855056038*^9}},ExpressionUUID->"fa4d7406-876f-4275-827b-\
0dc6ad556ebf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"boundaryDomains", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}]}], "}"}], "]"}], "]"}], "&"}], 
    "/@", "bubbles"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.901009606561457*^9, 3.9010096757190943`*^9}, {
  3.901009714523311*^9, 3.9010097153227468`*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"56000397-47a3-4abb-9e3f-5efd447409b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bubbleInds", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"bubbles", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"boundaryDomains", "[", 
        RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "&"}], "/@", 
    RowBox[{"Range", "[", 
     RowBox[{"Length", "@", "data"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.901009678505269*^9, 3.901009831499875*^9}, 
   3.9010124383626738`*^9},
 CellLabel->
  "In[144]:=",ExpressionUUID->"44bf5c94-b77e-4c16-b13b-0d7777b125fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bubbleMeas", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ComponentMeasurements", "[", 
         RowBox[{
          RowBox[{"bubbles", "[", 
           RowBox[{"[", "#", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Area\>\"", ",", "\"\<Holes\>\""}], "}"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"bubbleInds", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], "&"}], "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "@", "data"}], "]"}]}], ",", "1"}], "]"}]}], 
  ";"}]], "Input",
