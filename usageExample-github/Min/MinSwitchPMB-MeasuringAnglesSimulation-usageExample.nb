Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"quadrupleVerticesRaw", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"branchPointCoords", "[", 
        RowBox[{"[", "ind", "]"}], "]"}], ",", 
       RowBox[{"tripleVertices", "[", 
        RowBox[{"[", 
         RowBox[{"ind", ",", "All", ",", "1"}], "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ind", ",", 
       RowBox[{"Length", "@", "data"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"quadrupleVertices", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"x", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"DeleteCases", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Norm", "[", 
                   RowBox[{
                    RowBox[{"x", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", "#"}], "]"}], "&"}], 
                 "/@", 
                 RowBox[{"quadVertices", "[", 
                  RowBox[{"[", 
                   RowBox[{";;", 
                    RowBox[{"x", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}]}], ",", 
                "0."}], "]"}], "]"}], ">", "10"}], ",", 
            RowBox[{"x", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "I"}], "]"}]}], "]"}], "/@", 
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "#", "]"}], "]"}], ",", "#"}], "}"}], 
           "&"}], "@", "quadVertices"}], "]"}]}], ",", "I"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"quadVertices", ",", "quadrupleVerticesRaw"}], "}"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "/@", "quadrupleVertices"}]}], "Input",
 CellChangeTimes->{{3.891254137188241*^9, 3.891254185362881*^9}, {
