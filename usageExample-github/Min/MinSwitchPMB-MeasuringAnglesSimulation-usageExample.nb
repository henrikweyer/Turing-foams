Cell[CellGroupData[{

Cell["Number of corners of each domain", "Section",
 CellChangeTimes->{{3.894598845723718*^9, 
  3.894598851484858*^9}},ExpressionUUID->"66c6de99-3a63-429a-9af5-\
301c78436330"],

Cell["\<\
Use only internal bubbles not in contact with the boundary because those \
bubbles are not expected to have 6 corners.

In this small simulation, no internal bubble exists.\
\>", "Text",
 CellChangeTimes->{{3.901012793161067*^9, 3.90101284191754*^9}, {
  3.9506116129527597`*^9, 
  3.9506116248736343`*^9}},ExpressionUUID->"bc3797f7-cf50-4f2d-ae45-\
bfd26f395cb5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"boundaryDomains", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{";;", "10"}], "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"-", "10"}], ";;"}], "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{";;", "10"}]}], "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{
             RowBox[{"-", "10"}], ";;"}]}], "]"}], "]"}]}], "}"}], "]"}], 
      "]"}], "&"}], "/@", "bubbles"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.901009606561457*^9, 3.9010096757190943`*^9}, {
  3.901009714523311*^9, 3.9010097153227468`*^9}, {3.901012698510154*^9, 
  3.901012719536009*^9}},
 CellLabel->
  "In[148]:=",ExpressionUUID->"86ea839d-1113-4be9-a643-2f8082f5fecb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"internalBubbleInds", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"bubbles", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"boundaryDomains", "[", 
        RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "&"}], "/@", 
    RowBox[{"Range", "[", 
     RowBox[{"Length", "@", "data"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.901009678505269*^9, 3.901009831499875*^9}, 
   3.9010124383626738`*^9, {3.901012753264994*^9, 3.90101275527526*^9}},
 CellLabel->
  "In[149]:=",ExpressionUUID->"e506823e-ab4c-4aa4-9040-56e17979ece3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cornerNumber", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Block", "[", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{"mask", "=", 
               RowBox[{"Dilation", "[", 
                RowBox[{
                 RowBox[{"Image", "[", 
                  RowBox[{"Map", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"#", "==", "b"}], ",", "1", ",", "0"}], "]"}], 
                    "&"}], ",", 
                    RowBox[{"bubbles", "[", 
                    RowBox[{"[", "sim", "]"}], "]"}], ",", 
                    RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", 
                 RowBox[{"DiskMatrix", "[", "1", "]"}]}], "]"}]}], "}"}], ",",
              "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"b", "==", "10"}], ",", "\[IndentingNewLine]", 
               RowBox[{"-", "1"}], 
               RowBox[{"(*", 
                RowBox[{
                "that", " ", "is", " ", "the", " ", "outside", " ", "of", " ",
                  "the", " ", "bubbles"}], "*)"}], ",", "\[IndentingNewLine]", 
               RowBox[{"Total", "@", 
                RowBox[{"Flatten", "[", 
                 RowBox[{
                  RowBox[{"ImageData", "[", 
                   RowBox[{"branchPoints", "[", 
                    RowBox[{"[", "sim", "]"}], "]"}], "]"}], "*", 
                  RowBox[{"ImageData", "[", "mask", "]"}]}], "]"}]}]}], 
              "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"b", ",", 
             RowBox[{"internalBubbleInds", "[", 
              RowBox[{"[", "sim", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"#", ">", "0"}], "&"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"sim", ",", 
         RowBox[{"Length", "@", "data"}]}], "}"}]}], "]"}], ",", "1"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.894556147326947*^9, 3.894556172461543*^9}, {
  3.894556237294952*^9, 3.894556387104582*^9}, {3.894556466076023*^9, 
