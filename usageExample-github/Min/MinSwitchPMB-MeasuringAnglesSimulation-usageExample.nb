  3.894552731763229*^9}},ExpressionUUID->"0190fdf5-ae2e-40f5-b23c-\
957a60548fe7"],

Cell["\<\
We define triple vertices as those branch points determined that are more \
than 10 pixels distant from other branch points (4-arm vertices are \
decomposed into two triple vertices in the network skeleton).\
\>", "Text",
 CellChangeTimes->{{3.894542544164115*^9, 3.894542631942885*^9}, {
  3.8945527375030727`*^9, 
  3.894552738398033*^9}},ExpressionUUID->"57681b76-3205-4b6f-b32f-\
3579e79821ef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tripleVertices", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"x", ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"Min", "[", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Norm", "[", 
                  RowBox[{"x", "-", "#"}], "]"}], "&"}], "/@", "bpCoords"}], 
               ",", "0."}], "]"}], "]"}]}], "}"}]}], "]"}], "/@", 
        "bpCoords"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], ">", "10"}], "&"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"bpCoords", ",", "branchPointCoords"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "/@", "tripleVertices"}]}], "Input",
 CellChangeTimes->{{3.891254049246869*^9, 3.891254074473*^9}, 
   3.891254751581483*^9, {3.891254836962092*^9, 3.891254862472891*^9}, {
   3.891255457391128*^9, 3.891255457799524*^9}, {3.891255574346841*^9, 
   3.891255587864821*^9}, {3.891258395073402*^9, 3.8912583955402102`*^9}, 
   3.894261957823991*^9, {3.894262036995399*^9, 3.89426203763408*^9}, 
