           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "&"}], "@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
