Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fittedVertices", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
