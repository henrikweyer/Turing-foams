               RowBox[{"2", ",", "All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"Rescale", "@", 
              RowBox[{"vertexData", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "All", ",", "3"}], "]"}], "]"}]}]}], "}"}], 
           "]"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"iniCond", "=", 
