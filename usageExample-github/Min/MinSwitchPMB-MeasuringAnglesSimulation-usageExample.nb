Cell[CellGroupData[{

Cell["Determine branch points", "Subsection",
 CellChangeTimes->{{3.90094950043438*^9, 3.900949502634095*^9}, {
  3.900949544296365*^9, 
  3.900949546357373*^9}},ExpressionUUID->"0c3f478e-a16b-4218-bdbb-\
7270d595adb1"],

Cell["\<\
The branch width is about 4 pixels, see below.
We prun branches shorter than 10 pixels because for their vertices no \
reliable angles can be determined.\
\>", "Text",
 CellChangeTimes->{{3.894541600444528*^9, 3.894541678866337*^9}, 
   3.894541910155237*^9},ExpressionUUID->"177bb766-377f-4abb-b748-\
2e0882997674"],

Cell[BoxData[
 RowBox[{
  RowBox[{"branchImPrun", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Pruning", "[", 
      RowBox[{"#", ",", "10"}], "]"}], "&"}], "/@", "branchIm"}]}], 
  ";"}]], "Input",
