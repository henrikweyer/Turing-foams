                  RowBox[{"AccuracyGoal", "\[Rule]", "2"}], ",", 
                  RowBox[{"PrecisionGoal", "\[Rule]", "2"}], ",", 
                  RowBox[{"Method", "->", "\"\<PrincipalAxis\>\""}]}], 
                 "]"}]}], ",", "I"}], "]"}]}], ";", "\[IndentingNewLine]", 
