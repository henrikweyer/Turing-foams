Cell["\<\
The fit data for each vertex is taken as the data points within a 15 pixel \
large radius around the branch point. If a second branch point lies closer \
than 15 pixels, the radius is reduced to this distance.\
\>", "Text",
 CellChangeTimes->{{3.894553033240812*^9, 3.894553101331559*^9}, {
  3.894555978697199*^9, 3.894556008776628*^9}, {3.9118047096298647`*^9, 
  3.911804711655347*^9}},ExpressionUUID->"be6a9a83-1a4c-42b4-b94d-\
43b43454527d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vertex3Data", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"vertex", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "-", 
              RowBox[{"vertex", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", 
              RowBox[{"vertex", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "&"}], "/@", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"dataPos", "[", 
               RowBox[{"[", 
                RowBox[{"#", ",", 
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"Floor", "[", 
                    RowBox[{"dy", "-", 
                    RowBox[{"vertex", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "-", "25"}], 
                    "]"}]}], "]"}], ";;", 
                  RowBox[{"Min", "[", 
                   RowBox[{"dy", ",", 
                    RowBox[{"Ceiling", "[", 
                    RowBox[{"dy", "-", 
                    RowBox[{"vertex", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "+", "25"}], 
                    "]"}]}], "]"}]}], ",", 
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"Floor", "[", 
                    RowBox[{
                    RowBox[{"vertex", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", "25"}], 
                    "]"}]}], "]"}], ";;", 
                  RowBox[{"Min", "[", 
                   RowBox[{"dx", ",", 
                    RowBox[{"Ceiling", "[", 
                    RowBox[{
                    RowBox[{"vertex", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", "25"}], 
                    "]"}]}], "]"}]}]}], "]"}], "]"}], ",", "1"}], "]"}], ",", 
            
            RowBox[{
             RowBox[{
              RowBox[{"Norm", "[", 
               RowBox[{
                RowBox[{"vertex", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "-", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}]}], "]"}], "<", 
              RowBox[{"Min", "[", 
               RowBox[{"15", ",", 
                RowBox[{"vertex", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "&"}]}], 
           "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"vertex", ",", 
         RowBox[{"tripleVertices", "[", 
          RowBox[{"[", "#", "]"}], "]"}]}], "}"}]}], "]"}], "&"}], "/@", 
    RowBox[{"Range", "[", 
     RowBox[{"Length", "@", "data"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.894602028347781*^9, 3.894602056079806*^9}, {
   3.894602180252767*^9, 3.894602184958138*^9}, {3.894602482188884*^9, 
