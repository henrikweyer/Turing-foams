       "\[IndentingNewLine]", 
       RowBox[{"fitSuccess", "=", "1"}], ",", "\[IndentingNewLine]", "fit"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "get", " ", "initial", " ", "conditions", " ", "for", " ", "the", " ", 
       "angles", " ", "of", " ", "the", " ", "vertex", " ", "arms", " ", "by",
        " ", "making", " ", "a", " ", "radial", " ", "histogram", " ", "and", 
       " ", "finding", " ", "its", " ", "peaks"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dataW", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"WeightedData", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
