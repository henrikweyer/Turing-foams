Cell["\<\
Fit the vertex by assuming Gaussian cross-sections of the vertex arms:\
\>", "Text",
 CellChangeTimes->{{3.894552914695421*^9, 
  3.8945529519667683`*^9}},ExpressionUUID->"11bf09cc-6531-4cf7-8c98-\
90a548de5cf9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "@", "lossF"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lossF", "[", 
    RowBox[{"vertexData_", ",", 
     RowBox[{"x1_", "?", "NumericQ"}], ",", 
     RowBox[{"x2_", "?", "NumericQ"}], ",", 
     RowBox[{"angles_", "?", "VectorQ"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Total", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"d", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"d", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "-", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "#"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"width", "/", "2"}], ")"}], "^", "2"}], "/", 
