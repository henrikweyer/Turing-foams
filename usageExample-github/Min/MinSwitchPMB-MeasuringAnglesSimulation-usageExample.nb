Cell[CellGroupData[{

Cell["Triple vertices", "Subsection",
 CellChangeTimes->{{3.894261757298098*^9, 3.894261760150309*^9}, {
  3.8945423779376*^9, 3.894542378909984*^9}, {3.8945425946228027`*^9, 
